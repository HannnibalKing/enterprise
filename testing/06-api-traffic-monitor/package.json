{
  "name": "@enterprise/api-traffic-monitor",
  "version": "1.0.0",
  "description": "Runtime API traffic interceptor — logs, validates, and anomaly-detects every request/response between frontend and backend",
  "main": "dist/index.js",
  "bin": {
    "api-monitor": "dist/proxy.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:proxy": "ts-node src/proxy.ts",
    "start:proxy": "node dist/proxy.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
