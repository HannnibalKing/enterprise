{
  "name": "@enterprise/security-dashboard",
  "version": "1.0.0",
  "description": "Unified security dashboard — aggregates reports from all 9 Enterprise security tools into a real-time web UI",
  "main": "dist/server.js",
  "bin": {
    "security-dashboard": "dist/server.js"
  },
  "scripts": {
    "build": "tsc && cd frontend && npm run build",
    "build:server": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "dev:server": "ts-node src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "node dist/server.js",
    "install:all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
